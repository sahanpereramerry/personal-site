---
const works = [
  {
    title: "From 100 Articles to 3 That Matter",
    description: "How I built an automated briefing system that filters noise and surfaces what actually matters.",
    href: "/articles/briefing-system"
  },
  {
    title: "What I Learned Writing for a CEO",
    description: "The difference between ghostwriting and thought leadership—and why finding the right angle matters more than the writing.",
    href: "/articles/ceo-writing"
  }
];
---

<section id="work" class="section-container">
  <h2 class="text-3xl md:text-4xl font-serif mb-16">Selected Work</h2>

  <div class="space-y-12">
    {works.map((work) => (
      <a
        href={work.href}
        class="block group"
      >
        <article class="border-l-2 border-dark-border pl-6 py-2 hover:border-accent transition-colors duration-300">
          <h3 class="text-xl md:text-2xl font-serif text-white group-hover:text-accent transition-colors duration-300 mb-3">
            {work.title}
          </h3>
          <p class="text-gray-400 leading-relaxed">
            {work.description}
          </p>
        </article>
      </a>
    ))}
  </div>
</section>
