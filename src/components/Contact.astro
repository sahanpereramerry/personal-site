---
const email = "spereramerry@gmail.com";
const linkedin = "https://www.linkedin.com/in/sahanpm/";
---

<section id="contact" class="section-container">
  <h2 class="text-3xl md:text-4xl font-serif mb-8">Get in Touch</h2>

  <p class="text-gray-300 text-lg leading-relaxed mb-8">
    I'm always open to interesting conversations about AI, marketing, or the space where they overlap.
  </p>

  <div class="flex flex-col sm:flex-row gap-6">
    <a
      href={`mailto:${email}`}
      class="inline-flex items-center gap-3 text-xl text-accent hover:text-white transition-colors duration-300 group"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform duration-300">
        <rect width="20" height="16" x="2" y="4" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
      <span>Email</span>
    </a>

    <a
      href={linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-3 text-xl text-accent hover:text-white transition-colors duration-300 group"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform duration-300">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
        <rect width="4" height="12" x="2" y="9"/>
        <circle cx="4" cy="4" r="2"/>
      </svg>
      <span>LinkedIn</span>
    </a>
  </div>
</section>
