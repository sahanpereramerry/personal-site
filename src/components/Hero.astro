<section id="hero" class="min-h-screen flex items-center justify-center">
  <div class="section-container">
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-16">
      <!-- Photo -->
      <div class="flex-shrink-0">
        <img
          src="/headshot.png"
          alt="Sahan Perera-Merry"
          class="w-48 h-48 md:w-64 md:h-64 rounded-full object-cover"
        />
      </div>

      <!-- Text -->
      <div class="text-center md:text-left">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-medium leading-tight mb-6">
          I make AI systems work for marketing teams
        </h1>
        <p class="text-xl md:text-2xl text-gray-400 max-w-xl leading-relaxed">
          I make the technology work. More importantly, I make the people work together.
        </p>
        <p class="text-sm text-gray-500 mt-4">
          MSc Data Science, UCL. Previously at Trilateral Research.
        </p>
        <div class="mt-8">
          <a
            href="#work"
            class="inline-flex items-center gap-2 text-accent hover:text-white transition-colors duration-300"
          >
            <span>View my work</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14M19 12l-7 7-7-7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
